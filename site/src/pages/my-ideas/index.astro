---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import {
  categories,
  editOnGitHub,
  paperBySlug,
  GITHUB_BRANCH,
  GITHUB_REPO,
} from '../../lib/papers';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topicNotes = await getCollection('myIdeaTopics');
// Files whose name starts with "_" are folder documentation, not notes.
const paperNotes = (await getCollection('myIdeaPapers')).filter((n) => !n.id.startsWith('_'));
const bySlug = new Map(categories.map((c) => [c.slug, c]));

// A note in the topics folder whose name is not one of the twelve README areas
// is a topic the reader invented. It gets its own page under /my-ideas/.
const areaSlugs = new Set(categories.map((c) => c.slug));
const ownTopics = topicNotes
  .filter((n) => !areaSlugs.has(n.id) && !n.id.startsWith('_'))
  .sort((a, b) => (a.data.title || a.id).localeCompare(b.data.title || b.id));

const ownTemplate = `---
title: "TITLE"
updated: ""
---

<!--
This file is yours. Automation may never rewrite, summarise, translate,
reorganise or delete anything you write here. The prompts below are optional -
delete them and write however you like.
-->

## Problem / research gap

## My hypothesis

## Proposed method

## Difference from prior work

## Required data or hardware

## Evaluation plan

## Risks and open questions

## Related notes
`;
---

<Base
  title="My Idea — Humanoid Robot Learning"
  description="A permanent, user-owned notebook: one free-form note per research area and per paper, never edited by automation."
>
  <div class="wrap narrow">
    <h1>My Idea</h1>
    <p class="lede">
      A permanent space for your own research notes. Every research area has one, and every
      paper page can have one. These files are yours: the maintenance automation may create a
      blank file when one is missing, but it never rewrites, summarises, translates,
      reorganises or deletes anything you write.
    </p>

    <h2>How it works</h2>
    <ul>
      <li>
        Area notes live in <code>site/src/content/my-ideas/topics/&lt;area-slug&gt;.md</code>.
      </li>
      <li>
        Paper notes live in <code>site/src/content/my-ideas/papers/&lt;paper-slug&gt;.md</code>
        and are created on demand from the “Create this note on GitHub” link on any paper page.
      </li>
      <li>
        Notes are free-form Markdown. The starter template suggests prompts — problem,
        hypothesis, proposed method, difference from prior work, data and hardware, evaluation
        plan, risks, related notes — and you can delete every one of them.
      </li>
      <li>
        You can also add <strong>a topic of your own</strong> that is not one of the twelve
        README areas &mdash; see below. It lives in the same folder, under any name you pick,
        and gets its own page.
      </li>
      <li>
        Generated summaries are never merged into these files; they live in
        <code>site/src/content/topics/</code> instead.
      </li>
    </ul>

    <h2>Your own topics ({ownTopics.length})</h2>
    <p>
      A note here is not tied to the paper list, so it can be about anything &mdash; a thesis
      chapter, a problem you keep circling, a reading thread. Name it and it appears in this
      list with a page of its own.
    </p>

    <div
      class="rs-token newtopic"
      data-newtopic
      data-repo={GITHUB_REPO}
      data-branch={GITHUB_BRANCH}
      data-template={ownTemplate}
    >
      <div class="row">
        <input
          type="text"
          data-newtopic-name
          placeholder="e.g. Contact-rich whole-body loco-manipulation"
          aria-label="New topic name"
          autocomplete="off"
        />
        <button type="button" data-newtopic-go>Start this note on GitHub</button>
      </div>
      <p class="tip" data-newtopic-hint>
        Opens GitHub&rsquo;s new-file page with the starter template filled in. Commit it there
        and the topic appears here after the next deploy.
      </p>
    </div>

    {
      ownTopics.length > 0 && (
        <ul class="papers">
          {ownTopics.map((n) => (
            <li>
              <span class="body">
                <a class="title" href={`${base}/my-ideas/${n.id}`}>
                  {n.data.title || n.id.replace(/-/g, ' ')}
                </a>
                <span class="meta">
                  <span class="links">
                    <a href={editOnGitHub(`site/src/content/my-ideas/topics/${n.id}.md`)}>
                      edit on GitHub
                    </a>
                  </span>
                </span>
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <h2>Area notes</h2>
    <ul class="papers">
      {
        categories.map((c) => {
          const note = topicNotes.find((n) => n.id === c.slug);
          return (
            <li>
              <span class="body">
                <a class="title" href={`${base}/topics/${c.slug}#my-idea`}>
                  {c.name}
                </a>
                <span class="meta">
                  <span class="badge">{note ? 'note started' : 'empty'}</span>
                  <span class="links">
                    <a href={editOnGitHub(`site/src/content/my-ideas/topics/${c.slug}.md`)}>
                      edit on GitHub
                    </a>
                  </span>
                </span>
              </span>
            </li>
          );
        })
      }
    </ul>

    <h2>Paper notes ({paperNotes.length})</h2>
    {
      paperNotes.length === 0 ? (
        <p class="notice">
          No paper notes yet. Open any paper page and use “Create this note on GitHub”.
        </p>
      ) : (
        <ul class="papers">
          {paperNotes.map((n) => {
            const p = paperBySlug.get(n.id);
            return (
              <li>
                <span class="body">
                  <a class="title" href={`${base}/papers/${n.id}#my-idea`}>
                    {p?.title ?? n.data.title ?? n.id}
                  </a>
                  <span class="meta">
                    <span class="links">
                      <a href={editOnGitHub(`site/src/content/my-ideas/papers/${n.id}.md`)}>
                        edit on GitHub
                      </a>
                    </span>
                  </span>
                </span>
              </li>
            );
          })}
        </ul>
      )
    }
    <p class="result-count">
      {bySlug.size} research areas tracked, {ownTopics.length} topic(s) of your own.
    </p>
  </div>
</Base>

<script>
  import { slugify } from '../../lib/slug';

  const box = document.querySelector<HTMLElement>('[data-newtopic]');
  if (box) {
    const input = box.querySelector<HTMLInputElement>('[data-newtopic-name]')!;
    const hint = box.querySelector<HTMLElement>('[data-newtopic-hint]')!;
    const original = hint.textContent;

    function open() {
      const name = input.value.trim();
      if (!name) {
        input.focus();
        return;
      }
      // Same slug rule as the rest of the site, so the file name and the URL
      // agree with what the Python pipeline would produce.
      const slug = slugify(name);
      const dir = 'site/src/content/my-ideas/topics';
      const body = box!.dataset.template!.replace('TITLE', name.replace(/"/g, "'"));
      const url =
        `https://github.com/${box!.dataset.repo}/new/${box!.dataset.branch}/${dir}` +
        `?filename=${encodeURIComponent(slug + '.md')}&value=${encodeURIComponent(body)}`;
      hint.textContent = `Opening GitHub to create ${slug}.md — commit it there and the topic appears here after the next deploy.`;
      window.open(url, '_blank', 'noopener');
    }

    box.querySelector('[data-newtopic-go]')!.addEventListener('click', open);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        open();
      }
    });
    input.addEventListener('input', () => {
      hint.textContent = original;
    });
  }
</script>
