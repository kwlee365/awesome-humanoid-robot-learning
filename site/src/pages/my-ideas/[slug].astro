---
/**
 * A page for a topic the reader invented.
 *
 * The twelve README areas each have a generated page at /topics/<slug>, and
 * their note lives at the bottom of it. A topic of the reader's own has no
 * generated page to hang off - nothing in the paper data knows about it - so it
 * gets one here. Same folder, same guard, same editor; only the home differs.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MyIdea from '../../components/MyIdea.astro';
import { categories } from '../../lib/papers';

export const getStaticPaths = (async () => {
  const notes = await getCollection('myIdeaTopics');
  const areas = new Set(categories.map((c) => c.slug));
  return notes
    .filter((note) => !areas.has(note.id) && !note.id.startsWith('_'))
    .map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = note.data.title || note.id.replace(/-/g, ' ');
---

<Base title={`${title} — My Idea`} description={`A research note on ${title}.`}>
  <div class="wrap narrow">
    <p class="breadcrumb">
      <a href={`${base}/my-ideas`}>My Idea</a> / Your own topics
    </p>
    <h1>{title}</h1>
    <p class="lede">
      A topic of your own. It is not one of the twelve README areas, so no paper list is
      generated for it &mdash; the note below is the whole page, and it is yours.
    </p>

    <MyIdea kind="topics" slug={note.id} subject={title} />
  </div>
</Base>
