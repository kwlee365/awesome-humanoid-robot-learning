---
import ReadingStatus from './ReadingStatus.astro';
import { formatDate, type Paper } from '../lib/papers';

interface Props {
  papers: Paper[];
  id?: string;
}

const { papers, id } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ul class="papers" id={id} data-paper-list>
  {
    papers.map((p) => (
      <li
        data-rs-host
        data-title={p.title.toLowerCase()}
        data-authors={p.authors.join(' ').toLowerCase()}
        data-categories={p.categories.join('|')}
        data-year={p.year ?? ''}
        data-venue={p.venue}
        data-status={p.publicationStatus}
        data-open={p.openSource ? '1' : '0'}
      >
        <span class="date">{formatDate(p)}</span>
        <span class="body">
          <a class="title" href={`${base}/papers/${p.slug}`}>{p.title}</a>
          <span class="meta">
            <span class="badge">{p.venue}</span>
            {p.openSource && <span class="badge ok">open-source</span>}
            {p.realRobot === true && <span class="badge accent">real robot</span>}
            {p.realRobot === false && <span class="badge">simulation only</span>}
            <span class="links">
              {p.paperUrl && <a href={p.paperUrl}>paper</a>}
              {p.projectUrl && <a href={p.projectUrl}>website</a>}
              {p.codeUrl && <a href={p.codeUrl}>code</a>}
            </span>
          </span>
        </span>
        <ReadingStatus slug={p.slug} title={p.title} />
      </li>
    ))
  }
</ul>
